# Application Environment & Security
APP_ENV=production
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial SuperAdmin credentials (used ONLY for initial database seeding on first start)
INITIAL_ADMIN_LOGIN=superadmin
INITIAL_ADMIN_PASSWORD=SuperAdminSecretPass123!
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FULL_NAME=Головний Системний Адміністратор

# Database Settings
# For local SQLite: sqlite+aiosqlite:///./service_desk.db
# For PostgreSQL in Docker, configure the credentials below:
POSTGRES_USER=sd_user
POSTGRES_PASSWORD=sd_password
POSTGRES_DB=sd_gen016
DATABASE_URL=sqlite+aiosqlite:///./service_desk.db

# Timezone of the facility (Ukraine timezone handling summer/winter daylight saving time)
FACILITY_TIMEZONE=Europe/Kyiv

# Storage path for file/photo uploads
UPLOAD_DIR=./uploads
