# ==============================================================================
# СТАТИЧНІ ІНФРАСТРУКТУРНІ НАЛАШТУВАННЯ (.env)
# ==============================================================================
# УВАГА: У цьому файлі зберігаються ЛИШЕ статичні параметри інфраструктури,
# бази даних та первинного облікового запису SuperAdmin.
# Усі динамічні параметри системи (часовий пояс, графік роботи, ціни на паливо,
# інтервали ТО, назва організації тощо) налаштовуються адміністратором
# безпосередньо в інтерфейсі системи (Вкладка «Адміністрування» -> «Системні налаштування»).
# ==============================================================================

# Application Environment & Security
APP_ENV=production
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial SuperAdmin credentials (used ONLY for initial database seeding)
INITIAL_ADMIN_LOGIN=superadmin
INITIAL_ADMIN_PASSWORD=SuperAdminSecretPass123!
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FULL_NAME=Головний Системний Адміністратор

# Database Settings (Static Infrastructure)
# For local SQLite: sqlite+aiosqlite:///./service_desk.db
# For PostgreSQL in Docker:
POSTGRES_USER=sd_user
POSTGRES_PASSWORD=sd_password
POSTGRES_DB=sd_gen016
DATABASE_URL=sqlite+aiosqlite:///./service_desk.db

# Storage path for file/photo uploads & CORS origins
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
